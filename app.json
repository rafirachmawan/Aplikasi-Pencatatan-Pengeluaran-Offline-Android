{
  "expo": {
    "name": "FinanceKU",
    "slug": "ExpoPencatatan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Finanku.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rafirachmawan.expopencatatan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
